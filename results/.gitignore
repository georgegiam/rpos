# Phase 3–8 experiment outputs (issue #22 run_experiment.sh + later phases); regenerated from a
# fixed seed on each run (CLAUDE.md §2), so not committed. The directory itself is kept.
*.csv
!.gitkeep
# Phase 4 committed deliverables (frozen baseline + running summary; not per-run outputs).
!baseline_unbound.csv
!experiments.csv
# Phase 5 #29 deliverable: simulator-vs-emulation calibration table (sim/calibrate.py).
!calibration.csv
# Phase 5 #30 deliverable: large-scale simulator results (sim/scale_sim.py).
!sim_scale.csv
# Phase 6 A1 deliverable: latency-vs-N table (experiments/a1_latency_vs_n.py). The figure
# (fig_A1_latency_vs_N.png) and A1_NOTES.md are not *.csv, so already tracked.
!A1_latency_vs_N.csv
# Phase 6 A1 raw per-run snapshots (experiments/run_a1.sh) — regenerable from the fixed seed
# (CLAUDE.md §2), so not committed; A1_latency_vs_N.csv is the committed summary.
a1/
